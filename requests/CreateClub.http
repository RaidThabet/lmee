### POST /api/clubs needs ADMIN. The token is fetched and refreshed by the
### IDE from the "keycloak" auth entry in http-client.env.json.
POST http://localhost:8080/api/clubs
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Esperance",
  "country": "Tunisia"
}

###
POST http://localhost:8080/api/clubs
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Sfaxien",
  "country": "Tunisia"
}
